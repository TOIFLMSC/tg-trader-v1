# Runtime execution and approval modes are stored in SQLite and controlled by the local Web UI.
# Live remains disarmed until a fresh private-API check and an explicit typed confirmation.

# my.telegram.org > API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Dedicated reader account, international phone format
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=data/telegram/reader.session

# Token issued by the official @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric ID of the owner's PERSONAL account (not reader account).
# Leave blank until local owner binding is implemented; never allow all users.
TELEGRAM_OWNER_ID=
# Initial channel ID; setup resolves it locally after reader authorization.
# Additional subscribed channels can be added later in the local Web UI.
TELEGRAM_TEST_CHANNEL_ID=

# OpenAI project API key; never use an organization admin key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Application-side monthly recognition budget. Ambiguous failures keep a conservative reservation.
LLM_MONTHLY_BUDGET_USD=20

# Local Web UI binds to 127.0.0.1 only.
UI_PORT=8787

# Paper uses public MEXC endpoints and needs no key.
# For Live create a dedicated futures API key with account/order read and futures trading.
# Bind it to the fixed VPS IP. Do not grant withdrawal permissions.
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_RECV_WINDOW_SECONDS=10
# Keep NO for read-only account checks. Change to the exact value YES only when
# you are ready to expose the separate Live activation control after a restart.
MEXC_LIVE_ORDERS_ENABLED=NO
